{
  "name": "yt-checker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.21.0 <12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "eval:classifier": "RUN_CLASSIFIER_EVAL=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run evals/classifier.spec.ts",
    "eval:parental-quality": "RUN_PARENTAL_QUALITY_EVAL=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run evals/parental-quality.spec.ts",
    "eval:parental-quality:stability": "QUALITY_RUNS=5 QUALITY_CONCURRENCY=3 RUN_PARENTAL_QUALITY_EVAL=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run evals/parental-quality.spec.ts"
  },
  "dependencies": {
    "nuxt": "^4.0.0",
    "openai": "^7.27.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "npm@11.21.0"
}

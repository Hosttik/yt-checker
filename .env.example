NUXT_TRANSCRIPT_API_KEY=
NUXT_TYPESAFE_API_KEY=

# Optional overrides:
# NUXT_TRANSCRIPT_API_BASE_URL=https://transcriptapi.com/api/v2
# NUXT_TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# NUXT_TYPESAFE_MODEL=jev-latest
# NUXT_TYPESAFE_BENIGN_DROP_PROBABILITY=0.8

# Scan persistence
# none/minimal are always allowed. diagnostic stores raw transcript/Jev payloads.
# Keep false in production.
NUXT_ALLOW_DIAGNOSTIC_STORAGE=false
# NUXT_SCAN_STORAGE_DIR=/data/scans

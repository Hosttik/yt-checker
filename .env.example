NUXT_TRANSCRIPT_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Defaults to OPENAI_MODEL; override only after measured evals justify it.
OPENAI_REVIEW_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Optional provider/classifier overrides:
# NUXT_TRANSCRIPT_API_BASE_URL=https://transcriptapi.com/api/v2

# Fast channel scan. Up to 10 videos from one scan may run concurrently, while
# provider calls are capped process-wide so simultaneous users do not multiply
# provider concurrency without bound.
SCAN_VIDEO_CONCURRENCY=10
# Process-wide provider slots shared by every simultaneous scan.
OPENAI_GLOBAL_CONCURRENCY=5
TRANSCRIPT_GLOBAL_CONCURRENCY=10

# Optional proactive provider budgets. Set these below the RPM/TPM limits shown
# for the production OpenAI project. Leave empty to rely on adaptive 429/503
# cooldown while measuring the real account limits.
# OPENAI_RPM_BUDGET=
# OPENAI_TPM_BUDGET=
OPENAI_RATE_LIMIT_RETRIES=2
# Set false for an A/B comparison with the legacy per-video detector/reviewer flow.
OPENAI_BATCHING_ENABLED=true

# Language-agnostic detector batching. Limits use a conservative UTF-8 token
# estimate; long videos are split automatically and short videos are coalesced.
OPENAI_DETECTOR_CHUNK_MAX_ESTIMATED_TOKENS=30000
OPENAI_DETECTOR_BATCH_MAX_ESTIMATED_TOKENS=70000
# Keep normal 10-video scans in two parallel detector requests instead of one
# long request; token limits still split unusually large videos further.
OPENAI_DETECTOR_BATCH_MAX_ITEMS=5
OPENAI_DETECTOR_CHUNK_OVERLAP_MS=90000
OPENAI_DETECTOR_COALESCE_MS=100
# Prevent one very long scan from occupying every global provider slot.
OPENAI_SCAN_BATCH_CONCURRENCY=2

# Candidate reviews from different videos are coalesced into scene-window batches.
OPENAI_REVIEW_BATCH_MAX_ESTIMATED_TOKENS=70000
OPENAI_REVIEW_BATCH_MAX_ITEMS=4
OPENAI_REVIEW_BATCH_MAX_CANDIDATES=12
OPENAI_REVIEW_COALESCE_MS=100
OPENAI_SCAN_REVIEW_BATCH_CONCURRENCY=2

# Operational logging: debug | info | warn | error | silent
NUXT_LOG_LEVEL=info

# Scan persistence.
# Keep diagnostic disabled for normal/public production.
NUXT_ALLOW_DIAGNOSTIC_STORAGE=false
# NUXT_SCAN_STORAGE_DIR=/data/scans

# UI defaults
# none | minimal | diagnostic
NUXT_PUBLIC_DEFAULT_STORAGE_MODE=minimal
# Empty = TranscriptAPI automatic; examples: ru, en, ru,en,asr
NUXT_PUBLIC_DEFAULT_TRANSCRIPT_LANGUAGE=
